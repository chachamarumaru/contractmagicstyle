<script>


/* =====================================
   契約書を出現
===================================== */

setTimeout(() => {


    document
        .getElementById("intro")
        .classList.remove("active");


    document
        .getElementById("contract")
        .classList.add("active");


    /*
     * 紙が出現してから
     *
     * 2.2秒間
     *
     * 本文は完全に空白
     */

    setTimeout(() => {

        startWriting();

    }, 2200);


}, 2000);



/* =====================================
   万年筆で書く演出
===================================== */

function startWriting() {


    const body =
        document.getElementById(
            "contractBody"
        );


    /*
     * ここで初めて本文を表示
     */

    body.style.visibility =
        "visible";


    /*
     * テキストを一文字ずつ分解
     */

    function processNode(node) {


        if (
            node.nodeType ===
            Node.TEXT_NODE
        ) {


            const fragment =
                document
                    .createDocumentFragment();


            [
                ...node.textContent
            ].forEach(char => {


                const span =
                    document
                        .createElement(
                            "span"
                        );


                span.className =
                    "char";


                span.textContent =
                    char;


                fragment.appendChild(
                    span
                );

            });


            node.parentNode.replaceChild(
                fragment,
                node
            );

        }


        else if (
            node.nodeType ===
            Node.ELEMENT_NODE
        ) {


            [
                ...node.childNodes
            ].forEach(
                processNode
            );

        }

    }


    [
        ...body.childNodes
    ].forEach(
        processNode
    );


    const chars =
        body.querySelectorAll(
            ".char"
        );


    /*
     * 文字を書く速度
     *
     * 速めだけど、
     * 一文字ずつ読める速度
     */

    let delay = 0;


    chars.forEach(char => {


        setTimeout(() => {

            char.classList.add(
                "written"
            );

        }, delay);


        delay += 20;

    });


    /*
     * 最後まで書き終わったら
     * 署名欄を出現
     */

    setTimeout(() => {


        document
            .getElementById(
                "signature"
            )
            .classList.add(
                "ready"
            );


    }, delay + 500);

}



/* =====================================
   署名
===================================== */

function signContract() {


    const contract =
        document.getElementById(
            "contract"
        );


    const complete =
        document.getElementById(
            "complete"
        );


    /*
     * 契約書が闇へ戻る
     */

    contract.classList.remove(
        "active"
    );


    setTimeout(() => {


        complete.classList.add(
            "active"
        );


    }, 900);

}

</script>

